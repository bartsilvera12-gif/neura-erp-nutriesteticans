# =============================================================================
# Nutriestéticans ERP — variables de entorno (ejemplo, SIN secretos)
# Instancia dedicada monocliente. Copiá a `.env.local` y completá los valores.
# =============================================================================

# --- Supabase / PostgREST (self-hosted VPS) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://api.neura.com.py
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Conexión directa Postgres (migraciones / scripts db:*). No exponer al browser.
# Formato: postgresql://USER:PASSWORD@HOST:PORT/postgres
SUPABASE_DB_URL=

# --- Identidad de la instancia (schema único) --------------------------------
# Schema Postgres operativo de esta instancia.
NEURA_CLIENT_SCHEMA=nutriesteticanserp
# Igual valor, expuesto al browser en build (evita fallback antiguo en el cliente).
NEXT_PUBLIC_NEURA_CLIENT_SCHEMA=nutriesteticanserp
NEURA_INSTANCE_MODE=single_client
NEURA_CLIENT_NAME=Nutriestéticans

# --- Entorno -----------------------------------------------------------------
NODE_ENV=production
